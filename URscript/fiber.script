def fiber_line():
  # 获取当前TCP位姿作为起始点
  local start_pose = get_actual_tcp_pose()

  # 设置工具中心点 (TCP)
  set_tcp(p[0, 0, 0, 0, 0, 0])

  # 定义速度和加速度参数
  local a_val = 0.3
  local v_val = 0.0005

  # 计算目标位置: 在当前位置基础上偏移，保持姿态不变
  local target1 = start_pose
  target1[0] = start_pose[0] + 0.003  # X +1mm
  target1[1] = start_pose[1] + 0.003  # Y +1mm
  target1[2] = start_pose[2] + 0.002  # Z +5mm

  # 移动到目标位置
  movel(target1, a=a_val, v=v_val)

  # 返回起始位置
  movel(start_pose, a=a_val, v=v_val)
end

# 调用函数
fiber_line()
